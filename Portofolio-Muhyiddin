<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Portofolio mahasiswa baru Informatika Universitas Negeri Surabaya.">
  <title>Portofolio | Mochammad Mahsun Muhyddin</title>
  <style>
    :root {
      --bg: #0b1020;
      --panel: #121a2e;
      --panel2: #18233b;
      --text: #eef3ff;
      --muted: #a9b6d0;
      --accent: #75e0c1;
      --accent2: #8ca7ff;
      --line: rgba(255,255,255,.12);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0; font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      color: var(--text); background: radial-gradient(circle at 80% 0%, #1a2d50 0, transparent 32%), var(--bg);
      line-height: 1.65;
    }
    a { color: inherit; text-decoration: none; }
    .wrap { width: min(1080px, calc(100% - 40px)); margin: auto; }
    header { position: sticky; top: 0; z-index: 10; background: rgba(11,16,32,.86); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
    nav { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    .brand { font-weight: 800; letter-spacing: .04em; }
    .brand span { color: var(--accent); }
    .navlinks { display: flex; gap: 24px; color: var(--muted); font-size: .92rem; }
    .navlinks a:hover { color: var(--accent); }
    .hero { min-height: 590px; display: grid; grid-template-columns: 1.3fr .7fr; align-items: center; gap: 50px; padding: 76px 0; }
    .eyebrow { color: var(--accent); font-size: .82rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
    h1 { font-size: clamp(2.6rem, 6vw, 4.8rem); line-height: 1.06; letter-spacing: -.055em; margin: 18px 0; }
    h1 span { color: var(--accent); }
    .lead { color: var(--muted); font-size: 1.1rem; max-width: 650px; }
    .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
    .btn { display: inline-flex; align-items: center; justify-content: center; padding: 12px 19px; border-radius: 999px; font-weight: 750; border: 1px solid var(--line); }
    .btn.primary { background: var(--accent); color: #08151a; border-color: var(--accent); }
    .btn:hover { transform: translateY(-2px); }
    .profile-card { background: linear-gradient(145deg, rgba(117,224,193,.13), rgba(140,167,255,.1)); border: 1px solid var(--line); border-radius: 28px; padding: 30px; box-shadow: 0 25px 80px rgba(0,0,0,.24); }
    .avatar { width: 92px; height: 92px; border-radius: 25px; display: grid; place-items: center; color: #08151a; font-size: 2rem; font-weight: 900; background: linear-gradient(135deg, var(--accent), var(--accent2)); margin-bottom: 24px; }
    .profile-card h2 { margin: 0 0 5px; font-size: 1.35rem; }
    .profile-card p { color: var(--muted); margin: 0; }
    .meta { display: grid; gap: 14px; margin-top: 24px; }
    .meta div { border-top: 1px solid var(--line); padding-top: 12px; }
    .meta small { display: block; color: var(--muted); }
    section { padding: 76px 0; }
    .section-head { max-width: 680px; margin-bottom: 32px; }
    .section-head h2 { font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1.15; margin: 8px 0 12px; letter-spacing: -.035em; }
    .section-head p { color: var(--muted); margin: 0; }
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .card { background: var(--panel); border: 1px solid var(--line); border-radius: 20px; padding: 24px; }
    .card .icon { font-size: 1.6rem; }
    .card h3 { margin: 12px 0 7px; }
    .card p, .card li { color: var(--muted); }
    .card ul { padding-left: 19px; margin-bottom: 0; }
    .tag { display: inline-block; border: 1px solid rgba(117,224,193,.32); color: var(--accent); background: rgba(117,224,193,.07); border-radius: 99px; padding: 5px 10px; font-size: .78rem; margin: 5px 5px 0 0; }
    .achievement { display: flex; align-items: flex-start; gap: 18px; }
    .achievement .icon { width: 52px; height: 52px; flex: 0 0 52px; display: grid; place-items: center; border-radius: 16px; background: var(--panel2); font-size: 1.4rem; }
    .achievement h3 { margin: 0 0 6px; }
    .achievement p { color: var(--muted); margin: 0; }
    .contact { background: linear-gradient(135deg, rgba(117,224,193,.12), rgba(140,167,255,.1)); border: 1px solid var(--line); border-radius: 28px; padding: clamp(26px, 5vw, 48px); display: flex; justify-content: space-between; align-items: center; gap: 24px; }
    .contact h2 { font-size: clamp(2rem, 4vw, 2.8rem); margin: 0 0 8px; }
    .contact p { color: var(--muted); margin: 0; }
    footer { padding: 28px 0; border-top: 1px solid var(--line); color: var(--muted); font-size: .88rem; text-align: center; }
    @media (max-width: 760px) {
      .hero { grid-template-columns: 1fr; gap: 28px; min-height: auto; padding: 65px 0; }
      .grid { grid-template-columns: 1fr; }
      .navlinks { gap: 12px; font-size: .78rem; }
      .brand { font-size: .9rem; }
      .contact { align-items: flex-start; flex-direction: column; }
    }
    @media (max-width: 440px) {
      .wrap { width: min(100% - 28px, 1080px); }
      nav { align-items: flex-start; flex-direction: column; padding: 14px 0; gap: 8px; }
      .navlinks { width: 100%; justify-content: space-between; }
    }
  </style>
</head>
<body>
